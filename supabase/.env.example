# Supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=NO-EXPOSAR-EN-EL-MOVIL

# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=crear-token-propio
META_APP_SECRET=app-secret-de-meta
WHATSAPP_ACCESS_TOKEN=token-temporal-o-permanente
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_TEMPLATE_NAME=daily_order_question
WHATSAPP_DRY_RUN=true
REQUIRE_SIGNATURE=true

# La app móvil nunca debe leer SUPABASE_SERVICE_ROLE_KEY.
# Configurá estos valores como secretos de Supabase Edge Functions.
